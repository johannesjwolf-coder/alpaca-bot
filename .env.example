# Vorlage für eine lokale .env im Repository-Hauptordner.
# Kopieren nach ".env" – diese Datei wird NICHT versioniert (.gitignore).
# Nur das Backend liest diese Werte. Das Frontend kennt keine Zugangsdaten.

# Authentifizierung gegenüber Alpaca:
#   proxy = Claude Code im Web; die Cloud ergänzt die Header per Network Secret
#   env   = eigener PC/Server; das Backend liest die Schlüssel unten
ALPACA_AUTH_MODE=env

# Nur für ALPACA_AUTH_MODE=env: Ihre Alpaca-PAPER-Schlüssel (keine Live-Schlüssel).
# Werte nur hier lokal eintragen, nie in Code, Chat oder Commits.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional (Standardwerte in Klammern)
# APP_HOST=127.0.0.1           (nur localhost)
# APP_PORT=8000
# APP_DB_PATH=backend/data/alpaca-bot.sqlite3
# APP_START_MODE=DEMO          (DEMO oder PAPER)
